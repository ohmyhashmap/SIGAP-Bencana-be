PORT=8787
NODE_ENV=development

# Koneksi PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigap_bencana
# Set true untuk PostgreSQL terkelola yang mewajibkan SSL (Supabase, Neon, Railway, dll.)
DATABASE_SSL=false

# Wajib diganti di produksi (string acak panjang)
JWT_SECRET=ganti-dengan-string-acak-panjang

# Origin frontend yang diizinkan, pisahkan dengan koma. "*" = semua origin.
CORS_ORIGIN=*

# Opsional: titik panas NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
HOTSPOT_SYNC_MINUTES=60

# Opsional: stasiun kualitas udara WAQI (https://aqicn.org/data-platform/token/).
# Tanpa token, kualitas udara memakai model Open-Meteo.
WAQI_TOKEN=

# Sumber berita eksternal (RSS 2.0)
NEWS_RSS_URL=https://www.cnbcindonesia.com/news/rss

# OpenAI-compatible API untuk embeddings dan jawaban RAG. Kosongkan untuk menonaktifkan inferensi.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Instruksi transfer yang ditampilkan ke pengguna; admin mengonfirmasi pembayaran secara manual.
PAYMENT_INSTRUCTIONS=

# Akun uji untuk `npm run seed`
SEED_USERNAME=auditor
SEED_PASSWORD=Auditor123!

# Hanya untuk `npm test` (isi tabel database ini akan dikosongkan)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigap_bencana_test
